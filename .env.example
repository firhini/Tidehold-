# TIDEHOLD server configuration. Every value has a sane default — an empty
# environment runs a lively demo world. Copy to .env or set in your host.

# HTTP port + bind address
PORT=8080
HOST=0.0.0.0

# SQLite database file (created on first boot)
DB_PATH=./data/tidehold.db

# Where the built client lives (served as static files + SPA fallback)
CLIENT_DIST=./client/dist

# --- World pacing -----------------------------------------------------------
# Real seconds per game tick. 20 = lively demo. 60 = relaxed.
TICK_SECONDS=20

# Ticks between tide rises. The season ends after 8 rises.
#   Demo-day:   360 ticks × 20s  = one rise every 2 hours  (~16h season)
#   Weekly:     TICK_SECONDS=60, TIDE_INTERVAL_TICKS=10080 → one rise/week...
#   8-week season example: TICK_SECONDS=60, TIDE_INTERVAL_TICKS=10080
TIDE_INTERVAL_TICKS=360

# World shape (only applies when creating a NEW world/database)
WORLD_RADIUS=26
WORLD_SEED=421337

NODE_ENV=production
